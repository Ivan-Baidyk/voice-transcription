# ============================================================
# Voice Transcription Service — Environment Variables
# ============================================================
# Copy to .env and fill with real values.

# --- Database ---
# PostgreSQL connection string (asyncpg format)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voice_transcription

# --- Soniox API ---
# Get API key at: https://app.soniox.com/settings/api
SONIOX_API_KEY=your_soniox_api_key_here

# --- Webhook Base URL ---
# Public URL of your server (for Soniox callbacks)
SONIOX_WEBHOOK_BASE=https://transcript.yourdomain.com

# --- Limits ---
TRANSCRIPTION_LIMIT=5
# Comma-separated emails exempt from limits
LIMIT_EXEMPT_EMAILS=admin@company.com

# --- Email Notifications (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL=admin@company.com

# --- General ---
TZ=Europe/Moscow
LOG_LEVEL=info
