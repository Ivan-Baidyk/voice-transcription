# ============================================================
# Voice Transcription Service — Environment Variables
# ============================================================
# Copy to .env and fill with real values.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voice_transcription

# --- Soniox ---
SONIOX_API_KEY=your_soniox_api_key_here

# --- Webhook ---
SONIOX_WEBHOOK_BASE=https://transcript.yourdomain.com

# --- Limits ---
TRANSCRIPTION_LIMIT=5
LIMIT_EXEMPT_EMAILS=admin@company.com

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL=admin@company.com

# --- General ---
TZ=Europe/Moscow
LOG_LEVEL=info
